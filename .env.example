APP_DIR=../app
APP_ENV=dev
APP_HOST=localhost
APP_PORT=8080

# PHP-Image-Version (Build-Arg, Aenderung erfordert "make build")
# Hinweis: aktuelle Doctrine-/PHPUnit-/Symfony-UX-Versionen verlangen teils schon PHP 8.4+,
# bei "composer update"-Fehlern wegen PHP-Version lieber hier hochziehen statt Lockfile zu erzwingen.
PHP_VERSION=8.3

ENABLE_XDEBUG=0
PHP_IDE_CONFIG=serverName=symfony-devstack
PHP_MEMORY_LIMIT=512M
CLIENT_MAX_BODY_SIZE=64M

# Datenbank: Image-Version + Credentials, muss zu DATABASE_URL passen
DB_VERSION=11
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root
DATABASE_URL=mysql://app:app@db:3306/app

# Adminer-Port, bei mehreren parallel laufenden Projekten anpassen
ADMINER_PORT=8081

# Composer-Image-Version (Major reicht meist)
COMPOSER_VERSION=2

SHOPWARE_HOSTNAME=shopware.local
SHOPWARE_IP=CHANGE_ME
